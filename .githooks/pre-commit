#!/usr/bin/env node

// Fast gate: format + types + lint (cached). The full suite (jest)
// runs on pre-push, so commits stay under ~10s.
// ponytail: execSync with a single string (no DEP0190); commands are
// hardcoded, no user input reaches the shell.
const { execSync } = require("node:child_process");

const steps = [
  "pnpm format:check",
  "pnpm exec tsc --noEmit --noUnusedLocals --noUnusedParameters --incremental --tsBuildInfoFile node_modules/.cache/tsc-precommit.tsbuildinfo",
  'pnpm exec eslint "src/**/*.{ts,tsx}" "App.tsx" "index.ts" --cache --max-warnings 0',
];

try {
  for (const cmd of steps) execSync(cmd, { stdio: "inherit" });
} catch {
  process.exit(1);
}
