#!/usr/bin/env node

// Slow gate: full jest suite (cached) runs on push, not on every commit.
const { spawnSync } = require("node:child_process");

const pnpm = process.platform === "win32" ? "pnpm.cmd" : "pnpm";
const result = spawnSync(pnpm, ["exec", "jest", "--config", "jest.config.mjs"], {
  shell: process.platform === "win32",
  stdio: "inherit",
});
process.exit(result.status ?? 1);
