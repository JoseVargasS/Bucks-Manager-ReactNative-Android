{
  "name": "bucksmanagerandroid",
  "version": "1.0.0",
  "packageManager": "pnpm@11.9.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/comic-neue": "^0.4.1",
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/orbitron": "^0.4.2",
    "@expo-google-fonts/patrick-hand": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo-google-fonts/space-mono": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "expo": "~56.0.16",
    "expo-blur": "~56.0.4",
    "expo-constants": "~56.0.21",
    "expo-dev-client": "~56.0.23",
    "expo-file-system": "~56.0.8",
    "expo-font": "~56.0.7",
    "expo-modules-core": "~56.0.21",
    "expo-print": "~56.0.4",
    "expo-secure-store": "~56.0.4",
    "expo-sharing": "~56.0.22",
    "expo-splash-screen": "~56.0.13",
    "pnpm": "^11.13.0",
    "react": "19.2.3",
    "react-native": "0.85.3",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^10.6.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "jest": "^29.7.0",
    "test-renderer": "^1.2.0",
    "ts-jest": "^29.4.11",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "scripts": {
    "android": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1",
    "android:release": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-android.ps1 release",
    "android:build-dev": "eas build -p android --profile development",
    "ci": "pnpm format:check && pnpm lint && pnpm test",
    "eslint:fix": "eslint . --fix",
    "format:check": "node scripts/check-format.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "install:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/install-apk.ps1",
    "lint": "tsc --noEmit --noUnusedLocals --noUnusedParameters && eslint \"src/**/*.{ts,tsx}\" \"App.tsx\" \"index.ts\" --max-warnings 0",
    "start": "expo start",
    "test": "npx jest --config jest.config.mjs --no-cache",
    "test:coverage": "npx jest --config jest.config.mjs --coverage --no-cache",
    "test:watch": "npx jest --config jest.config.mjs --watch",
    "doctor": "npx react-doctor@latest"
  },
  "private": true,
  "overrides": {}
}
